{% apply inky_to_html|inline_css(source('@SilverbackApiComponents/assets/css/foundation-emails.css'), source('@SilverbackApiComponents/assets/css/emails.css')) %}
    <container>
        <row class="header">
            <columns>

                <spacer size="16"></spacer>

                <center>
                    <img src="{{ email.image(email_logo) }}" alt="{{ website_name }}" class="logo"{% if email_logo_width %} width="{{ email_logo_width }}" style="width: {{ email_logo_width }}px"{% endif %}>
                </center>
            </columns>
        </row>
        <row>
            <columns>
                <spacer size="16"></spacer>

                {% block content %}{% endblock %}
            </columns>
        </row>
        <spacer size="16"></spacer>
    </container>
{% endapply %}
